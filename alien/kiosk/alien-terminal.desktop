[Desktop Entry]
# Linux / Raspberry Pi: скопировать в ~/.config/autostart/ и поправить путь к index.html.
# Выход из киоска: Alt+F4.
Type=Application
Name=Alien terminal
Exec=sh -c 'sleep 5; chromium --kiosk --incognito --noerrdialogs --disable-session-crashed-bubble --disable-pinch --overscroll-history-navigation=0 "file:///home/pi/alien/index.html?view=archive&script=piqad&qr=pulse" || chromium-browser --kiosk "file:///home/pi/alien/index.html?view=archive&script=piqad&qr=pulse"'
X-GNOME-Autostart-enabled=true
